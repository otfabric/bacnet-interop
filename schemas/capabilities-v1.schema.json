{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/bacnet-interop/schemas/capabilities-v1.schema.json",
  "title": "bacnet-interop adapter inventory v1",
  "description": "adapters/inventory.yaml (docs/CONTAINER_CONTRACT.md, Capabilities): what each image is and does, per capability cell. scripts/validate-fixtures.py validates the file against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_version", "fixture", "fixture_frozen", "adapters"],
  "properties": {
    "schema_version": { "const": "1" },
    "adapter_version": { "$ref": "#/$defs/version" },
    "fixture": { "$ref": "#/$defs/name" },
    "fixture_frozen": { "$ref": "#/$defs/name" },
    "fixtures_single_adapter": {
      "description": "Fixtures shipped by one adapter only: fixture name -> the adapter ids that ship it.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/name" }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "cells": {
      "description": "Capability -> cell. native: the upstream does it; adapter-shim: adapter code does it on upstream primitives; unsupported: not available; topology-aid: provided by a topology image for the test set-up.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "enum": ["native", "adapter-shim", "unsupported", "topology-aid"] }
    },
    "client_cells": {
      "description": "Client-mode capability -> cell (docs/CLIENT_DRIVER_CONTRACT.md).",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "enum": ["native", "adapter-shim", "unsupported"] }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "upstream", "upstream_version", "role", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/otfabric/bacnet-interop-[a-z0-9-]+$" },
        "upstream": { "type": "string", "minLength": 1 },
        "upstream_version": { "type": "string", "minLength": 1 },
        "upstream_commit": {
          "description": "The upstream commit, optionally followed by a note.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}( .+)?$"
        },
        "role": { "enum": ["peer-oracle", "topology-aid", "native-router"] },
        "since": { "$ref": "#/$defs/version" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["device", "client", "sim"] }
        },
        "evidence": { "$ref": "#/$defs/cells" },
        "capabilities": { "$ref": "#/$defs/cells" },
        "client_capabilities": { "$ref": "#/$defs/client_cells" }
      }
    }
  }
}
