<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: MIT -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>device_server</AssemblyName>
    <RootNamespace>Otfabric.BacnetInterop.SysIoBacnet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- Exact upstream pin. Override with -p:SysIoBacnetVersion=<x.y.z> (the
         Dockerfile passes SYSIOBACNET_VERSION). -->
    <SysIoBacnetVersion Condition="'$(SysIoBacnetVersion)' == ''">4.0.0</SysIoBacnetVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- "[x]" is an exact-version range: NuGet must restore precisely this
         package, never a newer one, and nuget.org versions are immutable.
         Its dependencies (Microsoft.Extensions.Logging.Abstractions 8.0.3 and
         Microsoft.Extensions.DependencyInjection.Abstractions 8.0.2 for BACnet
         4.0.0) are declared as minimum versions, which NuGet resolves to the
         lowest applicable one: the restore graph is the same on every build. -->
    <PackageReference Include="BACnet" Version="[$(SysIoBacnetVersion)]" />
  </ItemGroup>
</Project>
