{
  "id": "server-extended-v1",
  "description": "Segmentation, SubscribeCOVProperty(Multiple), GetAlarmSummary, GetEnrollmentSummary, text messages and ConfirmedPrivateTransfer against a server that serves device-server-v1: what the bacnet-stack tools cannot issue. Scenarios depend on the ones before them (FILE-STREAM-3 content, AV-2 event state).",
  "requires_fixture": "device-server-v1",
  "scenarios": [
    {
      "id": "arf.file3.segmented-reply",
      "service": "atomic-read-file",
      "object": "file,3",
      "start": 0,
      "count": 3000,
      "description": "One request for the whole 3000-octet file: the AtomicReadFile-ACK exceeds the largest B/IP APDU (1476), so it arrives as a segmented ComplexACK (clause 5.2)",
      "expect": {
        "octets_base64": ""
      }
    },
    {
      "id": "awf.file3.segmented-request",
      "service": "atomic-write-file",
      "object": "file,3",
      "start": 0,
      "data_base64": "",
      "description": "3000 octets in one AtomicWriteFile-Request: larger than the server's Max_APDU_Length_Accepted (1476), so the client segments the request (clause 5.2); the server accepts segmented requests",
      "expect": {
        "ack": true
      }
    },
    {
      "id": "arf.file3.after-write",
      "service": "atomic-read-file",
      "object": "file,3",
      "start": 0,
      "count": 3000,
      "expect": {
        "octets_base64": ""
      }
    },
    {
      "id": "scovp.av1.pv.increment",
      "service": "subscribe-cov-property",
      "object": "analog-value,1",
      "property": "present-value",
      "cov_increment": 1.0,
      "process_id": 9,
      "confirmed": false,
      "lifetime": 5,
      "description": "The initial notification follows the acknowledgement (clause 13.15)",
      "expect": {
        "subscribed": {
          "notification": true
        }
      }
    },
    {
      "id": "scovp.av1.pv.cancel",
      "service": "subscribe-cov-property",
      "object": "analog-value,1",
      "property": "present-value",
      "process_id": 9,
      "cancel": true,
      "expect": {
        "subscribed": {
          "notification": false
        }
      }
    },
    {
      "id": "scovp.unknown-object",
      "service": "subscribe-cov-property",
      "object": "analog-value,999",
      "property": "present-value",
      "process_id": 9,
      "confirmed": false,
      "lifetime": 5,
      "expect": {
        "error": {
          "class": "object",
          "code": "unknown-object"
        }
      }
    },
    {
      "id": "scovp.unknown-property",
      "service": "subscribe-cov-property",
      "object": "analog-value,1",
      "property": 9999,
      "process_id": 9,
      "confirmed": false,
      "lifetime": 5,
      "expect": {
        "error": {
          "class": "property",
          "code": "unknown-property"
        }
      }
    },
    {
      "id": "scovpm.av1-av2",
      "service": "subscribe-cov-property-multiple",
      "process_id": 10,
      "confirmed": false,
      "lifetime": 5,
      "subscriptions": [
        {
          "object": "analog-value,1",
          "properties": [
            {
              "property": "present-value",
              "cov_increment": 1.0
            }
          ]
        },
        {
          "object": "analog-value,2",
          "properties": [
            {
              "property": "present-value",
              "cov_increment": 1.0
            }
          ]
        }
      ],
      "description": "The initial notification is a COVNotificationMultiple (clause 13.16)",
      "expect": {
        "subscribed": {
          "notification": true
        }
      }
    },
    {
      "id": "scovpm.cancel",
      "service": "subscribe-cov-property-multiple",
      "process_id": 10,
      "cancel": true,
      "subscriptions": [
        {
          "object": "analog-value,1",
          "properties": [
            {
              "property": "present-value"
            }
          ]
        },
        {
          "object": "analog-value,2",
          "properties": [
            {
              "property": "present-value"
            }
          ]
        }
      ],
      "description": "Without issueConfirmedNotifications and lifetime the request is a cancellation (clause 13.16)",
      "expect": {
        "subscribed": {
          "notification": false
        }
      }
    },
    {
      "id": "scovpm.unknown-object-second",
      "service": "subscribe-cov-property-multiple",
      "process_id": 11,
      "confirmed": false,
      "lifetime": 5,
      "subscriptions": [
        {
          "object": "analog-value,1",
          "properties": [
            {
              "property": "present-value"
            }
          ]
        },
        {
          "object": "analog-value,999",
          "properties": [
            {
              "property": "present-value"
            }
          ]
        }
      ],
      "description": "SubscribeCOVPropertyMultiple-Error names the first failed subscription",
      "expect": {
        "error": {
          "class": "object",
          "code": "unknown-object",
          "first_failed": {
            "object": "analog-value,999",
            "property": "present-value"
          }
        }
      }
    },
    {
      "id": "gas.normal",
      "service": "get-alarm-summary",
      "expect": {
        "alarms": []
      }
    },
    {
      "id": "ges.normal",
      "service": "get-enrollment-summary",
      "description": "AV-2 is the only event-enrolled object (intrinsic out-of-range reporting, Notification Class 1)",
      "expect": {
        "enrollments": [
          {
            "object": "analog-value,2",
            "event_state": "normal",
            "event_type": "out-of-range",
            "notification_class": 1
          }
        ]
      }
    },
    {
      "id": "ges.offnormal-filter.normal",
      "service": "get-enrollment-summary",
      "event_state_filter": "offnormal",
      "expect": {
        "enrollments": []
      }
    },
    {
      "id": "wp.av2.high",
      "service": "write-property",
      "object": "analog-value,2",
      "property": "present-value",
      "value": {
        "type": "real",
        "value": 90.0
      },
      "expect": {
        "ack": true
      }
    },
    {
      "id": "gas.av2.high-limit",
      "service": "get-alarm-summary",
      "expect": {
        "alarms": [
          {
            "object": "analog-value,2",
            "alarm_state": "high-limit"
          }
        ]
      }
    },
    {
      "id": "ges.av2.high-limit",
      "service": "get-enrollment-summary",
      "expect": {
        "enrollments": [
          {
            "object": "analog-value,2",
            "event_state": "high-limit",
            "event_type": "out-of-range",
            "notification_class": 1
          }
        ]
      }
    },
    {
      "id": "ges.offnormal-filter.high-limit",
      "service": "get-enrollment-summary",
      "event_state_filter": "offnormal",
      "description": "The offnormal filter keeps every off-normal state, high-limit included (clause 13.11)",
      "expect": {
        "enrollments": [
          {
            "object": "analog-value,2",
            "event_state": "high-limit",
            "event_type": "out-of-range",
            "notification_class": 1
          }
        ]
      }
    },
    {
      "id": "wp.av2.normal",
      "service": "write-property",
      "object": "analog-value,2",
      "property": "present-value",
      "value": {
        "type": "real",
        "value": 50.0
      },
      "expect": {
        "ack": true
      }
    },
    {
      "id": "gas.av2.after-normal",
      "service": "get-alarm-summary",
      "expect": {
        "alarms": []
      }
    },
    {
      "id": "ctm.normal",
      "service": "confirmed-text-message",
      "message": "hello from the interop client",
      "message_priority": "normal",
      "expect": {
        "ack": true
      }
    },
    {
      "id": "ctm.urgent",
      "service": "confirmed-text-message",
      "message": "urgent interop message",
      "message_priority": "urgent",
      "expect": {
        "ack": true
      }
    },
    {
      "id": "utm.normal",
      "service": "unconfirmed-text-message",
      "message": "hello from the interop client",
      "message_priority": "normal",
      "expect": {
        "sent": {
          "operation": "unconfirmed-text-message"
        }
      }
    },
    {
      "id": "cpt.vendor999",
      "service": "confirmed-private-transfer",
      "vendor_id": 999,
      "service_number": 1,
      "parameters": [
        {
          "type": "character-string",
          "value": "hello"
        }
      ],
      "description": "The server's hook returns no result block; the ConfirmedPrivateTransfer-ACK carries vendor and service number (clause 16.2)",
      "expect": {
        "ack": true
      }
    }
  ]
}
