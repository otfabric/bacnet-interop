{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/bacnet-interop/fixtures/schema/device.schema.json",
  "title": "bacnet-interop live device fixture",
  "description": "Object graph advertised by peer adapters (device-baseline-v1 through v8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture", "device_instance", "device_name", "port", "objects"],
  "properties": {
    "fixture": {
      "type": "string",
      "minLength": 1,
      "description": "Fixture revision identifier echoed in adapter ready events."
    },
    "description": { "type": "string" },
    "device_instance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194302
    },
    "device_name": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "object_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "description": "CreateObject/DeleteObject policy for adapters that honor device-baseline-v5.",
      "properties": {
        "creatable_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "analog-value",
              "binary-value",
              "analog-input",
              "binary-input",
              "file"
            ]
          },
          "uniqueItems": true
        },
        "precreated_deletable": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectRef" }
        },
        "protected_objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectRef" }
        },
        "allocated_instance_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4194302
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4194302
            }
          }
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bacnet-stack": {
          "type": "string",
          "description": "Which subset of this model bacnet-stack aligns (e.g. identity-only)."
        },
        "bacpypes3": {
          "type": "string",
          "description": "Which subset BACpypes3 constructs from this file."
        },
        "bacnet4j": {
          "type": "string",
          "description": "Which subset BACnet4J constructs from this file."
        },
        "worldiety": {
          "type": "string",
          "description": "Which subset the Worldiety adapter constructs from this file."
        }
      }
    }
  },
  "$defs": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instance"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "device",
            "analog-value",
            "binary-value",
            "analog-input",
            "analog-output",
            "binary-input",
            "binary-output",
            "trend-log",
            "notification-class",
            "event-enrollment",
            "file",
            "audit-log",
            "life-safety-point",
            "life-safety-zone"
          ]
        },
        "instance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194302
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instance", "object_name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "device",
            "analog-value",
            "binary-value",
            "analog-input",
            "analog-output",
            "binary-input",
            "binary-output",
            "trend-log",
            "notification-class",
            "event-enrollment",
            "file",
            "audit-log",
            "life-safety-point",
            "life-safety-zone"
          ]
        },
        "instance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194302
        },
        "object_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "present_value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "access_method": {
          "type": "string",
          "enum": ["stream", "record"]
        },
        "stream_data_base64": { "type": "string" },
        "records": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
